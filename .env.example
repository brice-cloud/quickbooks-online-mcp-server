QUICKBOOKS_CLIENT_ID=your_sandbox_client_id_here
QUICKBOOKS_CLIENT_SECRET=your_sandbox_client_secret_here
QUICKBOOKS_REFRESH_TOKEN=your_sandbox_refresh_token_here
QUICKBOOKS_REALM_ID=your_sandbox_company_id_here
QUICKBOOKS_REDIRECT_URI=http://127.0.0.1:8000/callback
QUICKBOOKS_ENVIRONMENT=sandbox

# This fork refuses every QUICKBOOKS_ENVIRONMENT value except unset or the
# exact string sandbox. production, SANDBOX, Sandbox, and prod do not start.
# The token file cannot switch the host. See docs/SANDBOX_FORK_SECURITY.md.

# QUICKBOOKS_TOKEN_STORE_PATH must be an absolute path in the process
# environment. The file may supply the credential keys above. It cannot set
# the environment, the tool allowlist, or QBO_PDF_OUTPUT_DIR.

# QUICKBOOKS_DISABLE_WRITE, QUICKBOOKS_DISABLE_UPDATE, and QUICKBOOKS_DISABLE_DELETE
# do not enable tools. create/update/delete tools, including create_deposit,
# stay unregistered until a reviewed code change adds a name to
# SANDBOX_WRITE_EXCEPTIONS. That list is empty.
